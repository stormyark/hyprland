/* Main Config (wallpaper) */

@import "~/.config/rofi/config.rasi"

/* ---- Configuration ---- */
configuration {
    /*---------- General setting ----------*/
    modi: "drun,run,window,emoji";
    case-sensitive: false;
    cycle: true;
    filter: "";
    scroll-method: 0;
    normalize-match: true;
    show-icons: true;
    icon-theme: "Papirus";
    steal-focus: false;
    font: "IBM Plex Mono 12";
    dynamic:             false;
    fixed-num-lines:     true;
    display-drun:        " ";
    drun-prompt:         " ";
}

* {
    /*font:            "JetBrains Mono 11";*/
    font:             "IBM Plex Mono 12";
    background-color: transparent;
    text-color:       rgba(255, 255, 255, 80%);
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}

window {
    /*background-color:  rgba (39,40,34,50%);*/
    background-color:   rgba (07,07,07,80%);
    border:             1px solid;
    border-color:       rgba(97, 175, 239, 5%);
    border-radius:      12px;
    width:              550px;
    height:             425px;
    location:           center;
    anchor:             center;
    padding:            15px;
}

mainbox {
    children:   [ inputbar, listview ];
    spacing:    15px;
}

inputbar {
    background-color:   @background;
    border:             1px solid;
    border-color:       rgba(97, 175, 239, 5%);
    border-radius:      8px;
    padding:            10px 15px;
    spacing:            10px;
    children:           [ prompt, entry ];
    text-color:         @foreground;
    font:               "Hack Nerd Font Bold 11";
}

prompt {
    enabled:      true;
    text-color:   @active-background;
    padding:      0 5px 0 0;
}

entry {
    enabled:            true;
    placeholder:        " 🎞️ Search / Choose Wallpaper";
    placeholder-color:  @active-foreground;
    text-color:         inherit;
    font:               "JetBrains Mono Bold 11";
}

listview {
    background-color: transparent;
    margin:             0px;
    columns:            6;
    lines:              8;
    fixed-height:       true;
    spacing:            8px;
    scrollbar:          false;
    flow:               horizontal;
    cycle:              true;
}

element {
    padding:            10px 15px;
    spacing:            10px;
    border-radius:      8px;
    horizontal-align:   0;
    orientation:        vertical;
}

element-icon {
    size:               1.4em;
    vertical-align:     0.5;
    background-color:   transparent;
}

element-text {
    text-color:         inherit;
    vertical-align:     0.5;
    horizontal-align:   0;
    font:               inherit;
}

element selected {
    /*background-color:   rgba(97, 175, 239, 50%);*/
    background-color:   rgba(255, 255, 255, 20%);
    text-color:         @foreground;
}
