* {
    /*font:            "JetBrains Mono 11";*/
    font:             "IBM Plex Mono 12";
    background-color: transparent;
    text-color:       rgba(255, 255, 255, 80%);
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}

window {
    transparency:       "real";
    background-color:   rgba(07,07,07,80%);
    border:             3px solid;
    border-color:       rgba(97, 175, 239, 5%);
    border-radius:      12px;
    width:              530px;
    height:             430px;
    location:           center;
    anchor:             center;
    padding:            15px;
}

mainbox {
    background-color:   transparent;
    children:           [ inputbar, listview ];
    spacing:            15px;
}

inputbar {
    background-color:   @background;
    border:             1px solid;
    border-color:       rgba(97, 175, 239, 5%);
    border-radius:      8px;
    padding:            10px 15px;
    spacing:            10px;
    children:           [ prompt, entry ];
    text-color:         @foreground;
    font:               "IBM Plex Mono 11";
}

prompt {
    enabled:      true;
    text-color:   @active-background;
    padding:      0 5px 0 0;
}

entry {
    enabled:            true;
    placeholder:        "search";
    placeholder-color:  @active-foreground;
    text-color:         inherit;
    font:               "IBM Plex Mono 12";
}

listview {
    background-color:   transparent;
    margin:             0px;
    columns:            1;
    lines:              8;
    fixed-height:       true;
    spacing:            8px;
    scrollbar:          false;
}

element {
    padding:            10px 15px;
    spacing:            10px;
    border-radius:      8px;
    horizontal-align:   0;
}

element-icon {
    size:               1.4em;
    vertical-align:     0.5;
}

element-text {
    text-color:         inherit;
    vertical-align:     0.5;
    horizontal-align:   0;
    font:               inherit;
}

element selected {
    /*background-color:   rgba(97, 175, 239, 50%);*/
    background-color:   rgba(255, 255, 255, 20%);
    text-color:         @foreground;
}

/* NOTE:
   To apply blur only to rofi instances using this theme, start rofi with a custom WM_CLASS, e.g.:
     rofi -show drun -theme ~/.config/rofi/launchernovo/themes/pywal-theme.rasi -class rofi-pywal

   Then use the picom snippet below (~/.config/rofi/picom-blur.conf) and include/merge it into your picom config.
*/
